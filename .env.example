# Plantilla. NO pongas valores reales aquí (este archivo va en git).
# Las variables NEXT_PUBLIC_WHATSAPP_NUMBER / CONTACT_EMAIL / CONTACT_PHONE / SITE_URL van
# COMENTADAS: si no existen se usan los valores reales de src/lib/constants.ts. No las dejes
# definidas y vacías (el código usa `??`, y SITE_URL vacía rompe el build).
# Supabase — obtén estos valores desde https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Datos de contacto (opcionales, solo para sobrescribir los de constants.ts)
# NEXT_PUBLIC_WHATSAPP_NUMBER=
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_SITE_URL=

# Webhook opcional pa' notificar cotizaciones a n8n / Slack / Discord
QUOTE_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=

# --- Seguridad y avisos (1-oct-2026) ---
# Correos con acceso a /admin, separados por coma. Si falta, solo entra dynatechgerencia@outlook.com.
ADMIN_EMAILS=
# Protege /api/keepalive (Vercel la manda sola en el cron si está definida).
CRON_SECRET=
# Aviso por correo de cotizaciones y mensajes nuevos (Resend). Sin estas dos, no se envía nada.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Remitente verificado en Resend. Si falta, se usa onboarding@resend.dev (solo entrega al dueño de la cuenta Resend).
RESEND_FROM=
